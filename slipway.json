{
  "$schema": "https://raw.githubusercontent.com/fresp/slipway-agents/refs/heads/dev/slipway.schema.json",
  "version": "0.15.7",
  "ralph_loop": {
    "enabled": true,
    "max_iterations": 2,
    "strategy": "reset",
    "block_on_exhaustion": false
  },
  "agents": {
    "slipway": {
      "model": "anthropic/claude-opus-4-8",
      "fallback_model": "anthropic/claude-sonnet-5",
      "category": "deep",
      "mode": "primary",
      "description": "Primary orchestrator — routes the pipeline, enforces step order, never generates content directly",
      "permission": {
        "edit": "deny",
        "task": {
          "*": "deny",
          "chartmaker": "allow",
          "cartographer": "allow",
          "hullwright": "allow",
          "bosun": "allow",
          "gunner": "allow",
          "coxswain": "allow",
          "rigger": "allow",
          "shipwright": "allow",
          "chronicler": "allow",
          "surveyor": "allow",
          "caulker": "allow"
        },
        "skill": {
          "*": "deny",
          "learnings-capture": "allow",
          "pipeline-extend": "allow",
          "pipeline-reverse-engineer": "allow",
          "pipeline-doctor": "allow",
          "pipeline-sync": "allow"
        }
      }
    },
    "chartmaker": {
      "model": "anthropic/claude-sonnet-5",
      "fallback_model": "anthropic/claude-haiku-4-5",
      "category": "standard",
      "mode": "subagent",
      "description": "Raw prompt / partial PRD → complete .ai/docs/01-prd.md with P0/P1/P2 ranking",
      "permission": {
        "edit": "allow",
        "task": "deny",
        "skill": {
          "*": "deny"
        }
      }
    },
    "cartographer": {
      "model": "anthropic/claude-sonnet-5",
      "fallback_model": "anthropic/claude-haiku-4-5",
      "category": "standard",
      "mode": "subagent",
      "description": "Reverse-engineers existing codebase into .ai/docs/ with confidence markers",
      "permission": {
        "edit": "allow",
        "task": "deny",
        "skill": {
          "*": "deny"
        }
      }
    },
    "hullwright": {
      "model": "anthropic/claude-sonnet-5",
      "fallback_model": "anthropic/claude-haiku-4-5",
      "category": "standard",
      "mode": "subagent",
      "description": "Invokes bootstrap-from-prd skill → .ai/docs/02–10 + AGENTS.md",
      "permission": {
        "edit": "allow",
        "task": "deny",
        "skill": {
          "*": "deny",
          "bootstrap-from-prd": "allow",
          "session-log": "allow",
          "docs-publish": "allow"
        }
      }
    },
    "bosun": {
      "model": "anthropic/claude-opus-4-8",
      "fallback_model": "anthropic/claude-sonnet-5",
      "category": "deep",
      "mode": "subagent",
      "description": "Cross-doc validation + per-doc health score 0–100 + severity-ranked findings",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "skill": {
          "*": "deny"
        }
      },
      "ralph_loop": {
        "block_on_exhaustion": true
      }
    },
    "rigger": {
      "model": "anthropic/claude-sonnet-5",
      "fallback_model": "anthropic/claude-haiku-4-5",
      "category": "standard",
      "mode": "subagent",
      "description": "Phase/milestone breakdown → .ai/planning/ with S/M/L sizing, dependency graph, and P0/P1/P2 phase ordering",
      "permission": {
        "edit": "allow",
        "task": "deny",
        "skill": {
          "*": "deny"
        }
      }
    },
    "coxswain": {
      "model": "anthropic/claude-sonnet-5",
      "fallback_model": "anthropic/claude-haiku-4-5",
      "category": "standard",
      "mode": "subagent",
      "description": "Multi-lens sprint grooming (Lead Dev, QA, DevOps, Complexity Audit) with cross-lens synthesis",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "skill": {
          "*": "deny",
          "groomer-lead-dev": "allow",
          "groomer-qa": "allow",
          "groomer-devops": "allow",
          "groomer-complexity-audit": "allow"
        }
      }
    },
    "shipwright": {
      "model": "anthropic/claude-sonnet-5",
      "fallback_model": "anthropic/claude-haiku-4-5",
      "category": "standard",
      "mode": "subagent",
      "description": "Update existing docs when a new feature is introduced — proactive ADR conflict pre-flight before scoping",
      "permission": {
        "edit": "allow",
        "task": "deny",
        "skill": {
          "*": "deny",
          "session-log": "allow"
        }
      }
    },
    "chronicler": {
      "model": "anthropic/claude-haiku-4-5",
      "fallback_model": "anthropic/claude-sonnet-5",
      "category": "quick",
      "mode": "subagent",
      "description": "Post-implementation doc sync — detect and classify drift (DRIFT / INTENTIONAL / UNKNOWN)",
      "permission": {
        "edit": "allow",
        "task": "deny",
        "skill": {
          "*": "deny",
          "learnings-capture": "allow",
          "session-log": "allow"
        }
      }
    },
    "surveyor": {
      "model": "anthropic/claude-sonnet-5",
      "fallback_model": "anthropic/claude-haiku-4-5",
      "category": "standard",
      "mode": "subagent",
      "description": "Post-implementation DB schema vs 04-data-models.md consistency check",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "skill": {
          "*": "deny"
        }
      }
    },
    "gunner": {
      "model": "anthropic/claude-opus-4-8",
      "fallback_model": "anthropic/claude-sonnet-5",
      "category": "deep",
      "mode": "subagent",
      "description": "Auth, secrets, attack surface, and dependency/image vulnerability audit — PASS / CONDITIONAL / BLOCK gate",
      "permission": {
        "edit": "allow",
        "webfetch": "ask",
        "task": "deny",
        "skill": {
          "*": "deny",
          "learnings-capture": "allow"
        },
        "bash": {
          "npm": "allow",
          "pnpm": "allow",
          "yarn": "allow",
          "pip": "allow",
          "pip-audit": "allow",
          "poetry": "allow",
          "trivy": "allow",
          "grype": "allow",
          "osv-scanner": "allow",
          "docker": "ask",
          "command": "allow"
        }
      }
    },
    "caulker": {
      "model": "anthropic/claude-opus-4-8",
      "fallback_model": "anthropic/claude-sonnet-5",
      "category": "deep",
      "mode": "subagent",
      "description": "Post-merge semantic conflict resolution across .ai/docs/ and AGENTS.md — never silently resolves true contradictions",
      "permission": {
        "edit": "allow",
        "task": "deny",
        "skill": {
          "*": "deny",
          "doc-merge-resolution": "allow"
        }
      }
    }
  },
  "categories": {
    "quick": {
      "model": "anthropic/claude-haiku-4-5",
      "description": "Trivial or pattern-matching tasks — fast and cheap"
    },
    "standard": {
      "model": "anthropic/claude-sonnet-5",
      "description": "Default for most generation and analysis tasks"
    },
    "deep": {
      "model": "anthropic/claude-opus-4-8",
      "fallback_model": "anthropic/claude-sonnet-5",
      "description": "Reasoning-heavy tasks — validation, security audit, orchestration"
    },
    "smart": {
      "model": "anthropic/claude-opus-4-8",
      "fallback_model": "anthropic/claude-sonnet-5",
      "description": "Autonomous decision-making at convenience gates under /slipway:smart — must match or exceed deep tier, since it replaces user judgment calls, never substitutes a cheaper model for speed"
    }
  }
}