{
  "$schema": "https://raw.githubusercontent.com/fresp/slipway-agents/refs/heads/dev/slipway.schema.json",
  "version": "0.13.1",
  "ralph_loop": {
    "enabled": true,
    "max_iterations": 2,
    "strategy": "reset",
    "block_on_exhaustion": false
  },
  "agents": {
    "slipway": {
      "model": "anthropic/claude-opus-4-8",
      "fallback_model": "anthropic/claude-sonnet-5",
      "category": "deep",
      "mode": "primary",
      "description": "Primary orchestrator — routes the pipeline, enforces step order, never generates content directly",
      "permission": {
        "task": {
          "*": "deny",
          "chartmaker": "allow",
          "cartographer": "allow",
          "hullwright": "allow",
          "bosun": "allow",
          "gunner": "allow",
          "coxswain": "allow",
          "rigger": "allow",
          "shipwright": "allow",
          "chronicler": "allow",
          "surveyor": "allow",
          "caulker": "allow"
        },
        "skill": {
          "*": "allow",
          "superpowers*": "deny",
          "subagent-driven-development*": "deny"
        }
      }
    },
    "chartmaker": {
      "model": "anthropic/claude-sonnet-5",
      "fallback_model": "anthropic/claude-haiku-4-5",
      "category": "standard",
      "mode": "subagent",
      "description": "Raw prompt / partial PRD → complete .ai/docs/01-prd.md with P0/P1/P2 ranking",
      "permission": {
        "task": "deny",
        "skill": {
          "*": "allow",
          "superpowers*": "deny",
          "subagent-driven-development*": "deny"
        }
      }
    },
    "cartographer": {
      "model": "anthropic/claude-sonnet-5",
      "fallback_model": "anthropic/claude-haiku-4-5",
      "category": "standard",
      "mode": "subagent",
      "description": "Reverse-engineers existing codebase into .ai/docs/ with confidence markers",
      "permission": {
        "task": "deny",
        "skill": {
          "*": "allow",
          "superpowers*": "deny",
          "subagent-driven-development*": "deny"
        }
      }
    },
    "hullwright": {
      "model": "anthropic/claude-sonnet-5",
      "fallback_model": "anthropic/claude-haiku-4-5",
      "category": "standard",
      "mode": "subagent",
      "description": "Invokes bootstrap-from-prd skill → .ai/docs/02–10 + AGENT.md",
      "permission": {
        "task": "deny",
        "skill": {
          "*": "allow",
          "superpowers*": "deny",
          "subagent-driven-development*": "deny"
        }
      }
    },
    "bosun": {
      "model": "anthropic/claude-opus-4-8",
      "fallback_model": "anthropic/claude-sonnet-5",
      "category": "deep",
      "mode": "subagent",
      "description": "Cross-doc validation + per-doc health score 0–100 + severity-ranked findings",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "skill": {
          "*": "allow",
          "superpowers*": "deny",
          "subagent-driven-development*": "deny"
        }
      },
      "ralph_loop": { "block_on_exhaustion": true }
    },
    "rigger": {
      "model": "anthropic/claude-sonnet-5",
      "fallback_model": "anthropic/claude-haiku-4-5",
      "category": "standard",
      "mode": "subagent",
      "description": "Phase/milestone breakdown → .ai/planning/ with S/M/L sizing, dependency graph, and P0/P1/P2 phase ordering",
      "permission": {
        "task": "deny",
        "skill": {
          "*": "allow",
          "superpowers*": "deny",
          "subagent-driven-development*": "deny"
        }
      }
    },
    "coxswain": {
      "model": "anthropic/claude-sonnet-5",
      "fallback_model": "anthropic/claude-haiku-4-5",
      "category": "standard",
      "mode": "subagent",
      "description": "Multi-lens sprint grooming (Lead Dev, QA, DevOps, Complexity Audit) with cross-lens synthesis",
      "permission": {
        "task": "deny",
        "skill": {
          "*": "allow",
          "superpowers*": "deny",
          "subagent-driven-development*": "deny"
        }
      }
    },
    "shipwright": {
      "model": "anthropic/claude-sonnet-5",
      "fallback_model": "anthropic/claude-haiku-4-5",
      "category": "standard",
      "mode": "subagent",
      "description": "Update existing docs when a new feature is introduced — proactive ADR conflict pre-flight before scoping",
      "permission": {
        "task": "deny",
        "skill": {
          "*": "allow",
          "superpowers*": "deny",
          "subagent-driven-development*": "deny"
        }
      }
    },
    "chronicler": {
      "model": "anthropic/claude-haiku-4-5",
      "fallback_model": "anthropic/claude-sonnet-5",
      "category": "quick",
      "mode": "subagent",
      "description": "Post-implementation doc sync — detect and classify drift (DRIFT / INTENTIONAL / UNKNOWN)",
      "permission": {
        "task": "deny",
        "skill": {
          "*": "allow",
          "superpowers*": "deny",
          "subagent-driven-development*": "deny"
        }
      }
    },
    "surveyor": {
      "model": "anthropic/claude-sonnet-5",
      "fallback_model": "anthropic/claude-haiku-4-5",
      "category": "standard",
      "mode": "subagent",
      "description": "Post-implementation DB schema vs 04-data-models.md consistency check",
      "permission": {
        "task": "deny",
        "skill": {
          "*": "allow",
          "superpowers*": "deny",
          "subagent-driven-development*": "deny"
        }
      }
    },
    "gunner": {
      "model": "anthropic/claude-opus-4-8",
      "fallback_model": "anthropic/claude-sonnet-5",
      "category": "deep",
      "mode": "subagent",
      "description": "Auth, secrets, attack surface, and dependency/image vulnerability audit — PASS / CONDITIONAL / BLOCK gate",
      "permission": {
        "webfetch": {
          "api.osv.dev": "allow",
          "*": "ask"
        },
        "task": "deny",
        "skill": {
          "*": "allow",
          "superpowers*": "deny",
          "subagent-driven-development*": "deny"
        },
        "bash": {
          "npm": "allow",
          "pnpm": "allow",
          "yarn": "allow",
          "pip": "allow",
          "pip-audit": "allow",
          "poetry": "allow",
          "trivy": "allow",
          "grype": "allow",
          "osv-scanner": "allow",
          "docker": "ask",
          "command": "allow"
        }
      }
    },
    "caulker": {
      "model": "anthropic/claude-opus-4-8",
      "fallback_model": "anthropic/claude-sonnet-5",
      "category": "deep",
      "mode": "subagent",
      "description": "Post-merge semantic conflict resolution across .ai/docs/ and AGENT.md — never silently resolves true contradictions",
      "permission": {
        "task": "deny",
        "skill": {
          "*": "allow",
          "superpowers*": "deny",
          "subagent-driven-development*": "deny"
        }
      }
    }
  },
  "categories": {
    "quick": { "model": "anthropic/claude-haiku-4-5", "description": "Trivial or pattern-matching tasks — fast and cheap" },
    "standard": { "model": "anthropic/claude-sonnet-5", "description": "Default for most generation and analysis tasks" },
    "deep": { "model": "anthropic/claude-opus-4-8", "fallback_model": "anthropic/claude-sonnet-5", "description": "Reasoning-heavy tasks — validation, security audit, orchestration" }
  }
}
