{
  "name": "slipway-agents",
  "version": "0.10.1",
  "description": "AI agent orchestration framework for OpenCode — PRD to engineering docs pipeline",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "slipway-agents": "bin/install.js"
  },
  "files": [
    "dist/",
    "bin/",
    "subagents/",
    "skills/",
    "slipway.md",
    "slipway.json",
    "slipway.schema.json",
    "opencode.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/plugin-handlers/command-config-handler.test.js",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist dist-test"
  },
  "keywords": [
    "opencode",
    "ai-agents",
    "llm",
    "developer-tools",
    "prd",
    "documentation",
    "pipeline",
    "subagents"
  ],
  "author": "fresp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fresp/slipway-agents.git"
  },
  "homepage": "https://github.com/fresp/slipway-agents#readme",
  "bugs": {
    "url": "https://github.com/fresp/slipway-agents/issues"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "opencode-ai": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "opencode-ai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "zod": "^4.4.3"
  }
}
