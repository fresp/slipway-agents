{
  "name": "slipway-agents",
  "version": "0.4.0",
  "description": "PRD-to-engineering-docs pipeline agents for OpenCode. One orchestrator, ten specialized subagents, Stakeholder Priority planning, model enforcement via slipway.json.",
  "bin": {
    "slipway-agents": "bin/install.js"
  },
  "files": [
    "bin/",
    "subagents/",
    "skills/",
    "slipway.md",
    "slipway.json",
    "slipway.schema.json",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/slipway-plugin",
    "typecheck": "npm run typecheck --workspace=packages/slipway-plugin",
    "clean": "rm -rf packages/slipway-plugin/dist"
  },
  "keywords": [
    "opencode",
    "ai-agents",
    "llm",
    "developer-tools",
    "prd",
    "documentation",
    "pipeline",
    "subagents"
  ],
  "author": "fresp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fresp/slipway-agents.git"
  },
  "homepage": "https://github.com/fresp/slipway-agents#readme",
  "bugs": {
    "url": "https://github.com/fresp/slipway-agents/issues"
  },
  "peerDependencies": {
    "opencode-ai": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "opencode-ai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
